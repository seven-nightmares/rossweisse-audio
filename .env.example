# Copy to .env (or run scripts/new-env.ps1, which also generates the secrets).
# .env is git-ignored. Never commit real values.

# PostgreSQL
DATABASE_NAME=audiostore
DATABASE_USERNAME=audiostore
DATABASE_PASSWORD=change-me

# Strapi secrets (random base64 strings; APP_KEYS is four, comma-separated)
APP_KEYS=change-me,change-me,change-me,change-me
API_TOKEN_SALT=change-me
ADMIN_JWT_SECRET=change-me
TRANSFER_TOKEN_SALT=change-me
JWT_SECRET=change-me
ENCRYPTION_KEY=change-me

# Storefront tokens, created by `docker compose exec cms npm run seed -- --with-token`
# (scripts/seed.ps1 does this and writes both into .env).
# Read-only: lets the storefront read published content.
STRAPI_API_TOKEN=
# Custom, Inquiry → create only: lets the storefront save form submissions.
STRAPI_INQUIRY_TOKEN=

# The storefront's public address, baked into its build for the inquiry form's CSRF check.
# Leave as-is locally; set to https://your-domain in production, then rebuild web.
SITE_ORIGIN=http://localhost:3001
