{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"build:demo": "cross-env BUILD_TARGET=demo BASE_PATH=/rossweisse-audio vite build",
		"preview:demo": "node scripts/serve-demo.js",
		"demo:generate": "node scripts/demo-content.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "npm run test:unit -- --run",
		"test:unit": "vitest",
		"test:e2e": "npm run build && cross-env PLAYWRIGHT_BROWSERS_PATH=../.tools/ms-playwright playwright test",
		"test:e2e:demo": "npm run build:demo && cross-env PLAYWRIGHT_BROWSERS_PATH=../.tools/ms-playwright E2E_TARGET=demo playwright test",
		"test:e2e:stack": "cross-env PLAYWRIGHT_BROWSERS_PATH=../.tools/ms-playwright E2E_TARGET=stack playwright test",
		"e2e:install": "cross-env PLAYWRIGHT_BROWSERS_PATH=../.tools/ms-playwright playwright install chromium"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24",
		"cross-env": "^10.1.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource-variable/archivo": "^5.3.0",
		"@fontsource-variable/newsreader": "^5.3.0",
		"valibot": "^1.5.0"
	}
}
